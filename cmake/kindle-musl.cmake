set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(ARM_TOOLCHAIN "$ENV{ARM_TOOLCHAIN}")
set(ARM_DEPS "$ENV{ARM_DEPS}")
if(NOT ARM_TOOLCHAIN OR NOT ARM_DEPS)
    message(FATAL_ERROR "Set ARM_TOOLCHAIN and ARM_DEPS; see tools/build-arm.sh")
endif()
set(CMAKE_C_COMPILER "${ARM_TOOLCHAIN}/bin/arm-linux-musleabi-gcc")
set(CMAKE_CXX_COMPILER "${ARM_TOOLCHAIN}/bin/arm-linux-musleabi-g++")
set(CMAKE_FIND_ROOT_PATH "${ARM_DEPS}" "${ARM_TOOLCHAIN}/arm-linux-musleabi")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_LIBRARY_SUFFIXES .a)
set(CMAKE_C_FLAGS_INIT "-Os -march=armv7-a -mfpu=vfpv3-d16 -mfloat-abi=softfp -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-static -Wl,--gc-sections")
